# Telemetría
NEXT_TELEMETRY_DISABLED=1

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slack_clone"

# Autenticación (Auth.js / NextAuth v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-string-in-production"

# Proveedores OAuth (Opcional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Microservicio de WebSockets
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
SOCKET_INTERNAL_URL="http://localhost:4000"
INTERNAL_SOCKET_SECRET="slack-clone-internal-socket-secret"
